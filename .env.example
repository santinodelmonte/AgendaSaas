# Variables para docker-compose.yml (copiar a .env; .env NO se versiona).

# Dominios públicos (los DNS tienen que apuntar al servidor).
DOMINIO_WEB=agenda.midominio.com
DOMINIO_API=api.midominio.com

# Base de datos.
MYSQL_ROOT_PASSWORD=cambiar-por-una-clave-larga
MYSQL_PASSWORD=cambiar-por-otra-clave-larga

# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_KEY=

# Superadmin que se crea al primer arranque.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Zona horaria del negocio (IANA).
APP_TIMEZONE=America/Argentina/Buenos_Aires
